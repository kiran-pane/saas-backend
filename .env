ENV=development
APP_SECRET_KEY=change-me-32-bytes-minimum-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

DB_USER=saas_app
DB_PASSWORD=change-me
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=saas_backend

DATABASE_URL=postgresql+asyncpg://saas_app:change-me@pgbouncer:5432/saas_backend
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Only needed for the live-stream supervisor's cross-tenant queries — see
# app/core/db/session.py::system_engine. Leave blank to default to
# DATABASE_URL (fine for owner-role setups); set to a BYPASSRLS-role
# connection string in a hardened deployment.
SYSTEM_DATABASE_URL=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=saas-backend-dev

DEFAULT_LLM_MODEL=openai:gpt-4.1-mini
DEFAULT_LLM_FALLBACKS=["anthropic:claude-sonnet"]

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- Google OAuth (Sign in with Google) ----
# Create these at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID is the only one required if the frontend uses Google's
# JS SDK and hands your backend an ID token (POST /api/v1/auth/google).
# Fill in CLIENT_SECRET + REDIRECT_URI only if you also want the backend
# to drive the full authorization-code exchange itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ---- Data seeding ----
# Leave SEED_PERMISSIONS_ON_STARTUP=false and run it manually the first
# time (`docker compose exec api python -m app.seeds.run permissions`),
# or set true to have it run automatically on every api container start
# (idempotent, safe either way).
SEED_PERMISSIONS_ON_STARTUP=false

# Set all four of these to bootstrap a demo tenant + Owner user by running
# `docker compose exec api python -m app.seeds.run dev-data`. Leave
# SEED_TENANT_SLUG blank (default) in any environment where you don't
# want a demo tenant created — this never runs implicitly.
SEED_TENANT_SLUG=
SEED_TENANT_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Flower (Celery monitoring UI) basic auth ----
FLOWER_BASIC_AUTH=admin:change-me

# ---- Storage abstraction layer ----
STORAGE_PROVIDER=local   # local | s3 | gcs | azure | cloudinary
STORAGE_MAX_UPLOAD_BYTES=209715200
STORAGE_PRESIGNED_URL_DEFAULT_TTL_SECONDS=900

# S3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=

# GCS
GCS_BUCKET=
GCS_CREDENTIALS_PATH=
GCS_KMS_KEY_NAME=

# Azure Blob
AZURE_ACCOUNT_URL=
AZURE_CONTAINER=
AZURE_ACCOUNT_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local filesystem (dev/test only — refused when ENV=production)
LOCAL_STORAGE_ROOT=/var/app/storage-dev

# ---- Virus scanning (ClamAV) ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=true

# ---- Storage lifecycle defaults ----
DEFAULT_OLD_VERSION_RETENTION_DAYS=30
DEFAULT_ARCHIVE_AFTER_DAYS=180

# ---- Audit log retention ----
AUDIT_LOG_RETENTION_MONTHS=24

# ---- HLS/FFmpeg media streaming ----
FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
FFMPEG_VOD_TIMEOUT_SECONDS=3600
LOCAL_MEDIA_IMPORT_ROOT=/var/app/media-import
LIVE_HLS_OUTPUT_ROOT=/var/app/live-hls
LIVE_RECORDING_TEMP_ROOT=/var/app/live-recordings
LIVE_STREAM_MAX_RESTARTS=5
LIVE_STREAM_POLL_INTERVAL_SECONDS=5

# ---- Payments ----
PAYMENT_PROVIDER=stripe   # stripe | razorpay | paypal

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true
